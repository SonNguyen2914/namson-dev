# Study Hub access (required before adding private course links)
STUDY_HUB_ACCESS_PASSWORD=
STUDY_HUB_SESSION_SECRET=
STUDY_HUB_COURSES_JSON=
STUDY_HUB_DATABASE_PATH=.data/study-hub.sqlite
STUDY_HUB_SYNC_INTERVAL_MINUTES=15

# Canvas read-only ingestion. Prefer a user access token when the school allows
# one. If it does not, use browser-session mode and run study-hub:canvas-login.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=
CANVAS_AUTH_MODE=
CANVAS_BROWSER_STORAGE_STATE=.data/canvas-browser-session.json
CANVAS_COURSE_IDS=

# Optional explicit GitHub course repositories. Public repositories do not
# require a token; a fine-grained read-only token raises limits/private access.
GITHUB_READ_TOKEN=
STUDY_HUB_GITHUB_REPOSITORIES_JSON=[]

# Google Drive living-document bridge. Keep the write switch false until OAuth
# is complete and the root folder is correct.
GOOGLE_DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Discord read-only bot. Each configured channel/thread is assigned to a course.
DISCORD_BOT_TOKEN=
STUDY_HUB_DISCORD_CHANNELS_JSON=[]
STUDY_HUB_INCLUDE_STUDENT_DISCUSSIONS_IN_AI=false

# Optional live prompting. The first adapter supports an OpenAI-compatible
# chat-completions endpoint; credentials remain server-side.
STUDY_HUB_AI_PROVIDER=
STUDY_HUB_AI_BASE_URL=
STUDY_HUB_AI_MODEL=
STUDY_HUB_AI_API_KEY=
